# Logs
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python / build output
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
build/
dist/

# Local environment and credentials -- must never be committed
.env
.env.*
clouds.yaml
secure.yaml
*openrc*
*.pem
*.key
*.pfx
*.p12

# Runtime data (user-specific, not tracked)
*.db
*.sqlite
*.sqlite3
data/*
!data/README.md

# Generated reports and exports (they hold real cloud data)
reports/
exports/
logs/
var/
*.docx
*.pptx
*.xlsx

# Screenshots may show real cloud data; only rendered diagrams are tracked
docs/images/*.png
!docs/images/architecture_rendered.png
!docs/images/workflow_rendered.png

# Local guard configuration (holds the terms that must never reach GitHub)
.openmove_guard_terms.json
.openmove_guard_allow.txt

# Scratch
_dbg.py
temp.*
